clock_unit ns
splash_steps 500000000 500000000 1000000000 1000000000 500000000
host Scenes::Splash[1].top_icon
host Scenes::Splash[1].bottom_icon
prepare Scenes::Splash[1] elapsed_ns=0
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[1].top_icon alpha=0.5
submit Scenes::Splash[1].bottom_icon alpha=0.5
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[1].top_icon alpha=1.0
submit Scenes::Splash[1].bottom_icon alpha=1.0
step delta_ns=1000000000 Shift=up Space=up
submit Scenes::Splash[1].top_icon alpha=1.0
submit Scenes::Splash[1].bottom_icon alpha=1.0
step delta_ns=1000000000 Shift=up Space=up
submit Scenes::Splash[1].top_icon alpha=0.5
submit Scenes::Splash[1].bottom_icon alpha=0.5
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[1].top_icon alpha=0.0
submit Scenes::Splash[1].bottom_icon alpha=0.0
emit Scenes::Splash[1].finished
release Scenes::Splash[1]
host Scenes::Title[1].title_card
prepare Scenes::Title[1]
step delta_ns=0 Shift=pressed Space=up
submit Scenes::Title[1].title_card time_milliseconds=0
press Shift
emit Scenes::Title[1].shift_pressed
release Scenes::Title[1]
host Scenes::Splash[2].top_icon
host Scenes::Splash[2].bottom_icon
prepare Scenes::Splash[2] elapsed_ns=0
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[2].top_icon alpha=0.5
submit Scenes::Splash[2].bottom_icon alpha=0.5
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[2].top_icon alpha=1.0
submit Scenes::Splash[2].bottom_icon alpha=1.0
step delta_ns=1000000000 Shift=up Space=up
submit Scenes::Splash[2].top_icon alpha=1.0
submit Scenes::Splash[2].bottom_icon alpha=1.0
step delta_ns=1000000000 Shift=up Space=up
submit Scenes::Splash[2].top_icon alpha=0.5
submit Scenes::Splash[2].bottom_icon alpha=0.5
step delta_ns=500000000 Shift=up Space=up
submit Scenes::Splash[2].top_icon alpha=0.0
submit Scenes::Splash[2].bottom_icon alpha=0.0
emit Scenes::Splash[2].finished
release Scenes::Splash[2]
host Scenes::Title[2].title_card
prepare Scenes::Title[2]
step delta_ns=0 Shift=up Space=pressed
submit Scenes::Title[2].title_card time_milliseconds=0
press Space
emit Scenes::Title[2].space_pressed
release Scenes::Title[2]
live_scene none
exit 0
