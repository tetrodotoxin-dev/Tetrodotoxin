dialect : Shader;

public Math : alias = package(.name = "Perimortem.Math", .version = "1.0");
implements source("render.ttx");

public phase_milliseconds : uniform U32 = new[U32];

Shader fragment[.color : Math::Vec4D] -> [.color : Math::Vec4D] {
  state phase_milliseconds := new[R32](parameters.phase_milliseconds);
  state phase := phase_milliseconds / new[R32](1000.0);
  state copied : Math::Vec4D = (
    .x = color.x + color.y + phase,
    .y = color.y + color.z,
    .z = color.z + color.w,
    .w = color.w + color.x,
  );
  return (copied.[x, y, z], phase);
}
