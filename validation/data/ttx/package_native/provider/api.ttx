// Public Object construction provider.
dialect : Library;

public shared : U64 = 40;

public ten : func = [] -> U64 : return 10;

public Config : object {
  private state hidden : U64 = Config -> hidden_default();
  public state value   : U64 = 7;

  public sum : func = [self] -> U64 : return self.hidden + self.value;

  private hidden_default : func = [] -> U64 : return 5;
}
