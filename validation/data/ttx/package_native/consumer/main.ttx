// Contract only Object construction consumer.
dialect : Library;

public Provider : alias =
    package(.name = "Validation.Provider", .version = "1.0");

public Value : alias = Provider::Api::U64;

public default_value : func = [] -> Value {
  state config : Provider::Api::Config;
  return config -> sum();
}

public static_value : func = [] -> Value : return Provider::Api.shared;
public supplied_value : func = [] -> Value {
  state config := new[Provider::Api::Config](.value = Provider::Api -> ten());
  return config -> sum();
}
