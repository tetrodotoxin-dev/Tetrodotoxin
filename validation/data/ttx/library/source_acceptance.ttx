// Library source acceptance.
dialect : Library;

@catalog("scalar") @catalog("scalar")
public CountAlias : alias = U64;

// Field Attributes remain source facts even when no Terminal consumes them.
@initializer @abi("C")
public session : Session = new[Session](.id = 7);

// One exact override keeps the positive legacy C symbol case beside the
// rejection tests for malformed and duplicate requests.
@abi("C") @symbol("source_acceptance") @tooling("entry") @tooling("entry")
public exported : func = [] -> CountAlias : return 7;

@presentation
public Mode : enum[U8] {
  idle = 0;
  ready = 1;
}

@value_type
public Packet : struct {
  @member
  public state nested : Nested;

  @nested_type
  public Nested : struct {
    @default_value
    public state value : CountAlias = 0;
  }
}

@reference_type
public Session : object {
  @identity
  public state id : CountAlias;
  @state
  expose state ready : Bool = false;
}
