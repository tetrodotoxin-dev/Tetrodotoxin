// TTX runtime and LLVM lowering acceptance.
dialect : Library;

foreign "C" {
  public func llvm_dense_access[] -> Access[U64];
  public func llvm_dense_view[] -> View[U64];
  public func llvm_object_identity[.value : Object[U8]] -> U64;
  public func ttx_system_print[.value : U64] -> [];
}

public Maybe : alias = Option[U64];
public Nested : alias = Option[Maybe];
public ObjectError : alias = Result[Bool, Counter];
public ObjectOutcome : alias = Result[Counter, Bool];
public Outcome : alias = Result[U64, Bool];
public WideOutcome : alias = Result[Bool, Large];
private CounterOptions : alias = Fixed[Option[Counter], 2];

private const absent  : Maybe = ();
private const present : Maybe = 5;

private object_static : Option[Counter] = new[Counter](.value = 2);
private dynamic       : Maybe = OptionOps -> lift(0);

public access_write : func = [.offset : U64] -> U64 {
  state selected : Access[U64] = DenseAccess -> acquire();
  selected[1]     = 20;
  selected[2, 2]  = (30 + offset, 40 + offset);
  selected[99]    = 50;
  selected[3, 2]  = (70, 80);
  return selected:[0] + selected:[1] + selected:[2] + selected:[3];
}

public bool_propagation : func = [.value : Bool] -> Maybe {
  value?;
  return 31;
}

public borrow_iteration : func = [] -> U64 {
  const prefix      : View[U8]       = "Echo: " -> get_view();
  const prefix_tail : View[U8]       = prefix -> slice(2, 99);
  state dense       : Fixed[U64, 4]  = (1, 2, 3, 4);
  state selected    : Access[U64]    = dense -> get_access();
  selected[1]     = 20;
  selected[2, 2]  = (30, 40);

  state fixed_view   : View[U64] = dense -> get_view();
  state default_view : View[U64] = FixedOps -> create() -> get_view();
  state fixed_tail   : View[U64] = fixed_view -> slice(2, 99);
  state access_tail  : View[U64] = selected -> slice(3, 99);
  state missing      : View[U64] = selected -> slice(99, 2);
  state total        : U64       = selected -> get_size();
  const empty        : View[U8]  = prefix -> slice(99, 1);
  const empty_state  : Bool      = empty -> is_empty();
  if selected -> is_empty() : return 0;
  if !missing -> is_empty() : return 0;
  if default_view -> is_empty() : return 0;
  if !empty_state : return 0;
  for [.entry : U64] in selected : total += entry;

  total += prefix -> get_size() + prefix_tail -> get_size();
  total += fixed_view -> get_size() + fixed_tail -> get_size();
  total += default_view -> get_size();
  total += access_tail -> get_size() + missing -> get_size();
  total += fixed_tail:[0] + access_tail:[0];

  state readonly : View[U64] = DenseView -> acquire();
  total += readonly -> get_size();
  for [.entry : U64] in readonly : total += entry;

  return total;
}

public object_iteration : func = [] -> U64 {
  state shared := new[Counter](.value = 3);
  state values : Fixed[Counter, 2] = (shared, shared);
  for [.entry : Counter] in values {
    entry -> add(1);
    if entry.value == 4 : continue;
  }
  for [.entry : Counter] in values {
    entry -> add(1);
    break;
  }
  return shared.value;
}

public bytes_api : func = [] -> U64 {
  const a     : U8 = 0x[41]:[0];
  const b     : U8 = 0x[42]:[0];
  const c     : U8 = 0x[43]:[0];
  const d     : U8 = 0x[44]:[0];
  const e     : U8 = 0x[45]:[0];
  const f     : U8 = 0x[46]:[0];
  const zero  : U8 = 0x[00]:[0];
  state value := Dynamic::Bytes -> copy("A" -> get_view());
  value -> reserve(16);

  state original_identity := value -> storage_identity();
  value -> append(b, 1);
  if value -> storage_identity() != original_identity : return 20;

  value -> append(c, 2);
  if value -> storage_identity() != original_identity : return 21;

  value -> concat("DE" -> get_view());
  if value -> storage_identity() != original_identity : return 22;

  state shared := value;
  value -> append(f, 1);
  if value -> storage_identity() == shared -> storage_identity() : return 23;
  if shared -> get_size() != 6 : return 2;
  if shared -> get_view():[5] != e : return 3;
  if value -> get_size() != 7 : return 4;
  if value -> get_view():[6] != f : return 5;

  value -> reserve(12);
  if value -> get_capacity() < 12 : return 6;

  value -> resize(10);
  if value -> get_view():[8] != zero : return 7;

  value -> resize(5) -> resize(7);
  if value -> get_view():[5] != e : return 8;
  if value -> get_view():[6] != f : return 9;

  value -> shrink(2);
  if value -> get_size() != 5 : return 10;
  if value -> get_view():[0] != c : return 11;
  if value -> slice(1, 3):[1] != d : return 12;

  state cleared := value;
  cleared -> clear();
  if cleared -> is_empty() == false : return 13;
  if cleared -> get_capacity() < 12 : return 14;

  state reset : Dynamic::Bytes;
  if reset -> is_empty() == false : return 15;
  if reset -> get_capacity() != 0 : return 16;

  state copied := Dynamic::Bytes -> copy(value -> get_view());
  if copied -> get_size() != 5 : return 17;
  if copied -> get_view():[0] != c : return 18;
  if shared -> get_view():[0] != a : return 19;

  state growth : Dynamic::Bytes;
  growth -> concat("growth" -> get_view());
  if growth -> get_size() != 6 : return 24;
  if growth -> get_view():[5] != 0x[68]:[0] : return 25;

  return 777;
}

public bytes_concat_size : func = [] -> U64 {
  const left   : View[U8] = "Hi" -> get_view();
  const right  : View[U8] = "!" -> get_view();
  state joined := Dynamic::Bytes -> concat(left, right);
  state tail   := joined -> slice(1, 99);
  state view   := joined -> get_view();
  return view -> get_size() + tail -> get_size();
}

public enumeration_iteration : func = [] -> U64 {
  const size  : U64 = Mode.size;
  state total : U64 = size;
  for [.value : Mode] in Mode : total += value -> get_name() -> get_size();
  for [.value : U8, .name : View[U8]] in Mode {
    total += name -> get_size();
    value;
  }

  return total;
}

// Test documentation string for function
@backend_note("opaque")
public execute : func = [] -> U64 {
  state pair_value : Pair = (.left = 2, .right = 3);

  // Test documentation string for variable
  state dense : Fixed[U64, 4] = (1, 2, 3, 4);
  const frozen_dense : Fixed[U64, 4] = (5, 6, 7, 8);
  state empty        : View[U64] = new[View[U64]];
  state writable     : Access[U64];
  state signed       : S64 = -2;
  state real         : R64 = 6.0;
  state mode         : Mode;
  state bytes        : Fixed[U8, 2] = 0x[01 02];
  state total        : U64 = pair_value -> sum();
  writable[99]    = 50;
  writable[0, 2]  = (5, 6);
  total += dense:[1];
  total += frozen_dense:[1];
  total += empty:[99];
  total += OptionOps -> forward(present)! + absent!;
  total += OptionOps -> lift(0)!;
  total += dynamic!;
  total += OptionOps -> nest(OptionOps -> lift(0))!!;
  bytes:[0];
  total += (24 * 2) / 6 - 8;

  // Call `access_write` which is a source level call.
  source -> access_write(7);

  const extracted := frozen_dense:[1];
  if !false and signed * -signed <= -4 and real / 2.0 == 3.0 : total += 0; else : total +=
      1000;
  if total != 0 and total >= 0 : total += 0;
  if total > 10 : total += 1;
  while total < 14 {
    total += 1;
    break;
  }

  for [.entry : U64] in 0...3 : total += entry;
  match total % 3 {
    case 0 : total += 3;
    case 1 : total -= 1;
    case _ : total += 25;
  }

  return total;
}

public large : func = [] -> Large : return LargeOps -> create();

// Foreign declares this exact provider name in another compiled product.
@abi("C") @symbol("llvm_large_sum")
public large_sum : func = [
  .value : Large,
] -> U64 : return value.first + value.second + value.third;
public object_add : func = [.value : Counter, .amount : U64] -> U64 : return value ->
    add(amount);
public object_behavior : func = [] -> U64 {
  state original  := new[Counter](.value = 4);
  state shared    : Counter = ObjectOps -> forward(original);
  state optional  : Option[Counter] = shared;
  state extracted : Counter = optional!;
  shared -> add(3);
  extracted -> add(5);
  optional = shared;

  state parameter_value : U64 = ObjectOps -> read_optional(shared);
  state holder := new[ObjectHolder](.selected = shared);
  state held : Counter = holder.selected!;
  held -> add(2);

  state inline_value    : ObjectInline = (.selected = shared);
  state inline_selected : Counter      = inline_value.selected!;
  inline_selected -> add(1);

  state options       : CounterOptions = (shared, shared);
  state option_access := options -> get_access();
  option_access[0]     = shared;
  option_access[0, 2]  = (shared, shared);

  state fixed_selected : Counter = options:[1]!;
  fixed_selected -> add(1);

  state static_value    : Counter = object_static!;
  state optional_pair   : Option[Pair] = (.right = 2, .left = 1);
  state selected_pair   : Pair = optional_pair!;
  state optional_fixed  : Option[Fixed[U64, 2]] = (3, 4);
  state selected_fixed  : Fixed[U64, 2] = optional_fixed!;
  state empty_objects   : View[Counter] = new[View[Counter]];
  state defaulted       : Counter = empty_objects:[9];
  state defaulted_value : U64 = defaulted -> add(1);
  state defaulted_range : Fixed[Counter, 2] = empty_objects:[9, 2];
  state first_default   : Counter = defaulted_range:[0];
  state second_default  : Counter = defaulted_range:[1];
  first_default -> add(5);

  state distinct_defaults : U64 = first_default.value + second_default.value;
  state recursive         := new[RecursiveObject];
  return original.value + parameter_value + static_value.value + recursive.value +
      selected_pair -> sum() + selected_fixed:[1] + defaulted_value + distinct_defaults;
}

public object_create : func = [] -> Counter {
  state created := new[Counter](.value = 7);
  return created;
}

public object_read : func = [.value : Counter] -> U64 : return value.value;
public object_results : func = [.value : Counter] -> [
  .optional : Option[Counter],
  .count : U64,
] : return (.count = value.value, .optional = value);
public object_static_value : func = [] -> U64 {
  state selected : Counter = object_static!;
  return selected.value;
}

public object_storage : func = [] -> U64 {
  state values : Object[U64];
  state access := values -> reserve(3);
  access[0] = 7;

  state copy := values;
  if !values -> is_shared() : return 0;
  copy -> get_access()[0] = 9;
  if values -> get_capacity() < 3 : return 0;

  return values -> get_view():[0] + copy -> get_view():[0];
}

public pair : func = [] -> Pair : return (.left = 9, .right = 4);
public result_error : func = [.value : Outcome] -> Bool {
  state selected := value?;
  selected;
  return false;
}

public result_error_object_propagation : func = [
  .value : ObjectError,
] -> ObjectError : return value?;
public result_object : func = [.value : Counter, .failed : Bool] -> ObjectOutcome {
  if failed : return failed;

  return value;
}

public result_object_propagation : func = [
  .value : ObjectOutcome,
] -> ObjectOutcome : return value?;
public result_propagation : func = [.value : Outcome] -> Outcome : return value?;
public result_wide_propagation : func = [.value : WideOutcome] -> WideOutcome : return value?;
public results : func = [] -> [.left : U64, .active : Bool] : return (.active = true, .left =
    7);

// One exported bridge starts the TTX-to-TTX runtime integration. Everything
// after entry selection is expressed by Library calls and value flow.
public runtime : func = [] -> [] : RuntimeIntegration -> run();
public small : func = [.value : U8, .active : Bool] -> U8 : return value;

private executable_acceptance : func = [.flag : Bool, .limit : U64] -> U64 {
  state total : U64 = 0;
  const one   : U64 = 1;
  Worker -> tick();
  if flag : total += one; else : total = limit;
  while flag {
    total += one;
    break;
  }

  for [.entry : U64] in 0...limit {
    if flag : continue;

    total += entry;
  }

  match flag {
    case false : return total;
    case true : return total + one;
  }
}

public Counter : object {
  public state value : U64 = 0;

  public add : func = [self, .amount : U64] -> U64 {
    self.value += amount;
    return self.value;
  }
}

public Dynamic : struct {
  public Bytes : struct {
    private state data : Object[U8];
    private state size : U64;

    public concat : func = [.left : View[U8], .right : View[U8]] -> Bytes {
      state left_size  := left -> get_size();
      state right_size := right -> get_size();
      state required   := left_size + right_size;
      state result     : Bytes;
      state access     := result.data -> reserve(required);
      for [.index : U64] in 0...left_size : access[index] = left:[index];
      for [.index : U64] in 0...right_size : access[left_size + index] = right:[index];

      result.size = required;
      return result;
    }

    public copy : func = [.view : View[U8]] -> Bytes : return Bytes -> concat(new[View[U8]],
      view);

    public append : func = [self, .byte : U8, .count : U64] -> self {
      if count == 0 : return self;

      state start    := self.size;
      state required := start + count;
      self -> prepare_write(required);

      state access := self.data -> get_access();
      for [.index : U64] in 0...count : access[start + index] = byte;

      self.size = required;
    }

    public clear : func = [self] -> self : self.size = 0;
    public concat : func = [self, .view : View[U8]] -> self {
      if view -> is_empty() : return self;

      state count    := view -> get_size();
      state start    := self.size;
      state required := start + count;
      self -> prepare_write(required);

      state access := self.data -> get_access();
      for [.index : U64] in 0...count : access[start + index] = view:[index];

      self.size = required;
    }

    public get_capacity : func = [self] -> U64 : return self.data -> get_capacity();
    public get_size : func = [self] -> U64 : return self.size;
    public get_view : func = [self] -> View[U8] : return self.data -> get_view() ->
        slice(0, self.size);
    public is_empty : func = [self] -> Bool : return self.size == 0;
    public reserve : func = [
      self,
      .required_size : U64,
    ] -> self : if required_size > self.data -> get_capacity() : self.data -> reserve(required_size);
    public resize : func = [self, .new_size : U64] -> self {
      if new_size > self.data -> get_capacity() : self.data -> reserve(new_size);

      self.size = new_size;
    }

    public shrink : func = [self, .count : U64] -> self {
      if count >= self.size : return self -> clear();
      if count == 0 : return self;

      state remaining := self.size - count;
      self -> prepare_write(self.size);

      state access := self.data -> get_access();
      for [.index : U64] in 0...remaining : access[index] = access:[index + count];

      self.size = remaining;
    }

    public slice : func = [self, .start : U64, .count : U64] -> View[U8] : return self ->
        get_view() -> slice(start, count);
    public storage_identity : func = [self] -> U64 : return foreign -> llvm_object_identity(
      self.data,
    );

    private prepare_write : func = [self, .required : U64] -> [] {
      self.data -> reserve(required);
      if self.data -> is_shared() : self.data -> clone();
    }
  }
}

public Large : struct {
  public state first  : U64 = 0;
  public state second : U64 = 0;
  public state third  : U64 = 0;
}

public Mode : enum[U8] {
  active = 1;
  idle = 0;
}

public Pair : struct {
  public state left  : U64 = 2;
  public state right : U64 = 3;

  public sum : func = [self] -> U64 : return self.left + self.right;
}

private DenseAccess : struct {
  public acquire : func = [] -> Access[U64] : return foreign -> llvm_dense_access();
}

private DenseView : struct {
  public acquire : func = [] -> View[U64] : return foreign -> llvm_dense_view();
}

private FixedOps : struct {
  public create : func = [] -> Fixed[U64, 2] : return (0, 0);
}

private LargeOps : struct {
  public create : func = [] -> Large : return (.third = 6, .first = 4, .second =
      5);
}

private ObjectHolder : object {
  public state selected : Option[Counter];
}

private ObjectInline : struct {
  public state selected : Option[Counter];
}

private ObjectOps : struct {
  public forward : func = [.value : Counter] -> Counter : return value;
  public read_optional : func = [.value : Option[Counter]] -> U64 {
    state selected : Counter = value!;
    return selected.value;
  }
}

private OptionOps : struct {
  // The private host keeps this Callable out of automatic publication. Its
  // explicit request exercises the deliberate native embedding path.
  @abi("C") @symbol("llvm_option")
  public forward : func = [.value : Maybe] -> Maybe : return value?;
  public lift : func = [.value : U64] -> Maybe : return value;
  public nest : func = [.value : Maybe] -> Nested : return value;
}

private RecursiveObject : object {
  private state next : Option[RecursiveObject];
  public state value : U64 = 1;
}

private RuntimeIntegration : struct {
  public calculate : func = [] -> U64 {
    const dense : Fixed[U64, 4] = (5, 6, 7, 8);
    state total : U64 = 15;
    total += dense:[1];
    return total;
  }

  public run : func = [] -> [] : System -> print(RuntimeIntegration -> calculate());
}

// System is the TTX-facing observation surface. Its provider remains one
// explicit host boundary while the runtime scenario decides what to print.
private System : struct {
  public print : func = [.value : U64] -> [] : foreign -> ttx_system_print(value);
}

// This compact body is inspected by the Library unit suite. Native execution
// uses the exported runtime and execute paths below.
private Worker : struct {
  public tick : func = [] -> [] : return;
}
