// Library value acceptance.
dialect : Library;

private constant_offset := source.slice_offset + 12;

public const slice_offset : U64 = 1;

private packet : Packet;
private sum := 2 + 3;
private sequence := 1...4;
private selected_byte := 0x[10 20 30]:[1];
private missing_byte := 0x[10 20 30]:[99];
private selected_slice : Fixed[U8, 2] = 0x[10 20 30]:[1, 2];
private missing_slice : Fixed[U8, 2] = 0x[10 20 30]:[99, 2];
private constant_slice : Fixed[U8, 2] = 0x[00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F]:[SliceParameters.offset +
    12, SliceParameters.size];
private called := Factory -> add(2, 3);
private addressed := packet.width;
private self_called := packet -> total();
private single : U64 = packet.[width];
private reordered : Pair = packet.[height, width];

private default_byte : func = [] -> U8 : return 0x[10 20 30]:[99];
private empty : func = [] -> [] : return packet.[];
private folded_add : func = [] -> U64 : return 2 + 3;

public Factory : struct {
  public add : func = [.left : U64, .right : U64] -> U64 : return left + right;
  public identity : func = [.value : Packet] -> Packet : return value;
}

public Packet : struct {
  public state width  : U64 = 2;
  public state height : U64 = 3;

  public total : func = [self] -> U64 : return self.width + self.height;
}

public Pair : struct {
  public state first  : U64;
  public state second : U64;
}

public SliceParameters : struct {
  public const offset : U64 = 1;
  public const size   : U64 = 2;
}
