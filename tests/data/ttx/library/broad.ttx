dialect : Library;

foreign "C" {
  public func library_observe[.value : U64] -> [];
}

public PacketAlias : alias = Packet;

private const mask     : U64 = 0xFF;
public const signature : Fixed[U8, 4] = 0x[54 54 58 31];

public observed_total  : U64 = 0;
public default_packet  : PacketAlias = (.width = 2, .height = 3, .ready = true);
public dense_defaults  : Fixed[U64, 4] = (1, 2, 3, 4);
private private_total  : U64 = 0;
private private_packet : Packet = (.width = 5, .height = 8, .ready = false);

public broad_entry : func = [.limit : U64, .ready : Bool] -> U64 {
  state local      : U64 = 0;
  state packet     : Packet = default_packet;
  state dense      : Fixed[U64, 4] = (1, 2, 3, 4);
  state middle     : Fixed[U64, 2] = dense:[1, 2];
  state dimensions : Fixed[U64, 2] = packet.[width, height];
  state negative   : S64 = -1;
  state accepted   : Bool = ready and limit > 0;
  state session    : Session = new[Session];
  if accepted : local = Packet -> identity(limit);
  while (local < limit) {
    local += 1;
    if local == 2 : continue;
    if !ready or local >= limit : break;
  }

  for [.index : U64] in 0...limit : local += index;
  match local % 3 {
    case 0 : local += 3;
    case 1 : local -= 1;
    case _ : local = local * 2 / 1;
  }

  packet.width = local;
  local        = packet -> identity();
  session -> advance(middle:[0]);
  foreign -> library_observe(dimensions:[0]);
  private_total  = PrivateOps -> combine(local, dense:[0]);
  observed_total = private_total;
  return observed_total;
}

public classify : func = [.value : U64] -> [.accepted : Bool, .adjusted : U64] : return (
  .adjusted = value + 1,
  .accepted = value > 0,
);
public positional_result : func = [.value : U64, .flag : Bool] -> [U64, Bool] : return (0,
  false);
public reset : func = [] -> [] : observed_total = 0;

public Mode : enum[U8] {
  active = 1;
  idle = 0;
  paused = 0x02;
}

// Packet is the broad fixture's inline value owner.
//
// The empty documentation line above must survive as a paragraph break.
public Packet : struct {
  public state width  : U64  = 0;
  public state height : U64  = 0;
  public state ready  : Bool = false;
  private checksum    : U64  = 0;

  public identity : func = [.value : U64] -> U64 : return value;

  public identity : func = [self] -> U64 : return Packet -> finish(self.width + self.height);

  private finish : func = [.value : U64] -> U64 : return value;
}

public Session : object {
  expose state progress : U64 = 0;
  private state token   : U64 = 7;

  public advance : func = [self, .amount : U64] -> U64 {
    self.progress += amount;
    return self.progress;
  }

  private token_value : func = [self] -> U64 : return self.token;
}

private PrivateOps : struct {
  public combine : func = [.left : U64, .right : U64] -> U64 : return left + right;
}
