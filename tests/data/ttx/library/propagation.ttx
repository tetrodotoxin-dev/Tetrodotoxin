// Library propagation and sum Type acceptance.
dialect : Library;

public Maybe   : alias = Option[U64];
public Outcome : alias = Result[U64, Bool];

private const absent         : Maybe = ();
private const absent_session : Option[Session] = ();
private const default_result := new[Outcome];
private const defaulted      := absent!;
private const failed         : Outcome = false;
private const present        : Maybe = 7;
private const selected       := present!;
private const succeeded      : Outcome = 11;

private first_session  : Session = absent_session!;
private second_session : Session = absent_session!;

public choose : func = [.value : Maybe] -> U64 {
  match value {
    case item : return item;
    case _ : return 0;
  }
}

public propagate : func = [.value : Maybe] -> Maybe : return value?;
public propagate_result : func = [.value : Outcome] -> Outcome : return value?;
public require : func = [.value : Bool] -> [] : value?;
public select_error : func = [.value : Outcome] -> Bool {
  state unwrapped := value?;
  unwrapped;
  return false;
}

public stop : func = [.value : Maybe] -> [] : state unwrapped := value?;

public Session : object {
  private state count : U64;
}
