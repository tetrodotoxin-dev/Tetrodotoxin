/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// Retains a Windowed startup profile without selecting a host or backend.
//
dialect : App;

private Main : alias = source("main.ttx");

runtime = Windowed {
  .title = "Profile Test",
  .icon = $[resources/icon.bin],
  .width = 800,
  .height = 600,
  .resizable = true,
}

lifecycle = Program {
  start Main -> run,
}
