{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests: build debug",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "//tests:all",
        "--config=debug",
        "--config=linux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "args": [
          "build",
          "//tests:all",
          "--config=debug",
          "--config=windows",
          "--features=generate_pdb_file"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Tests: build release",
      "type": "process",
      "command": "bazel",
      "args": [
        "build",
        "//tests:all",
        "--config=release",
        "--config=linux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "args": [
          "build",
          "//tests:all",
          "--config=release",
          "--config=windows"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Tests: run debug",
      "type": "process",
      "command": "bazel",
      "args": [
        "test",
        "//tests:all",
        "--config=debug",
        "--test_output=errors",
        "--config=linux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "args": [
          "test",
          "//tests:all",
          "--config=debug",
          "--test_output=errors",
          "--config=windows",
          "--features=generate_pdb_file"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Tests: run release",
      "type": "process",
      "command": "bazel",
      "args": [
        "test",
        "//tests:all",
        "--config=release",
        "--test_output=errors",
        "--config=linux"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "args": [
          "test",
          "//tests:all",
          "--config=release",
          "--test_output=errors",
          "--config=windows"
        ],
        "problemMatcher": [
          "$msCompile"
        ]
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "presentation": {
        "clear": true,
        "panel": "shared"
      }
    },
    {
      "label": "Tests: debug folders",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/.vscode/prepare_debug.py"
      ],
      "windows": {
        "command": "python"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Tests: prepare debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tests: build debug",
        "Tests: debug folders"
      ],
      "problemMatcher": []
    }
  ]
}
