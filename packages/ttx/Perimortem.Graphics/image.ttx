/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// Shared decoded pixels owned independently from target resources.
//
dialect : Library;

public Pixel : alias = source("pixel.ttx")::Pixel;
public Size2D : alias = source("size2d.ttx")::Size2D;

// Image is one shared decoded RGBA identity. Its pixels and dimensions describe
// content; sampling policy belongs to each Texture2D value that selects it.
public Image : object {
  private state pixels      : Object[Pixel];
  private state pixel_count : U64;
  expose state size         : Size2D;

  public get_pixels : func = [self] -> View[Pixel] : return self.pixels -> get_view() ->
      slice(0, self.pixel_count);
}
