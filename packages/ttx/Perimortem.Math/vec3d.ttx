/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// A three component real vector.
//
dialect : Library;

// Vec3D stores three ordered R32 components named x, y, and z.
//
// It remains a general vector so domain Packages can add their own spatial or
// color meaning without changing this shared Type.
@capability("vector")
public Vec3D : struct {
  public state x : R32;
  public state y : R32;
  public state z : R32;
}
