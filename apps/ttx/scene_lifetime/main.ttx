//
// Window and Scene stack policy for the Scene Lifetime application.
dialect : App;

private Splash : alias = source("scenes/splash.ttx");
private Title : alias = source("scenes/title.ttx");

// Opens the native presentation used by the Scene stack.
runtime = Windowed {
  .title = "Scene Lifetime",
  .icon = $[resources/icon.png],
  .width = 800,
  .height = 600,
  .resizable = true,
}

// The first matching Signal mapping chooses the one transition applied after
// the frame has been presented.
lifecycle = Scene {
  initial Splash;
  on Splash.finished replace Title;
  on Title.shift_pressed replace Splash;
  on Title.space_pressed exit;
}
