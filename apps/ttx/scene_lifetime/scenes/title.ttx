/// Tetrodotoxin
/// Copyright (c) 2023-present Matt Kaes and contributors
//
// A title screen that publishes keyboard input as Scene Signals.
dialect : Scene;

public Graphics : alias = package(.name = "Perimortem.Graphics", .version = "1.0");
public System : alias = package(.name = "Perimortem.System", .version = "1.0");
private Blend : alias = source("../shaders/blend.ttx");
using System::Key;

signal space_pressed;
signal shift_pressed;
private state title_card : Graphics::Sprite;
private state title_material : Blend::Material;
private state elapsed : R64 = 0.0;

Scene prepare[self] -> [] {
  state image := Graphics::Format::PNG -> decode(.bytes = $[../resources/logo.png] ->
      get_view())!;
  state texture : Graphics::Texture2D = (
    .image = image,
    .sampler = new[Graphics::Sampler2D],
  );
  state noise_image := Graphics::Format::PNG -> decode(.bytes = $[../resources/perlin.png] ->
      get_view())!;
  state noise_sampler : Graphics::Sampler2D = (
    .addressing = Graphics::Sampler2D::Addressing::wrap,
    .filtering = Graphics::Sampler2D::Filtering::linear,
  );
  state noise_texture : Graphics::Texture2D = (
    .image = noise_image,
    .sampler = noise_sampler,
  );
  state position : Graphics::Point2D = (.x = 100.0, .y = 220.0);
  state display_size : Graphics::Size2D = (.width = 600, .height = 157);
  self.elapsed = 0.0;
  self.title_card.texture = texture;
  self.title_material.noise = noise_texture;
  self.title_card.material = self.title_material;
  self.title_card.size = display_size;
  self.title_card.transform = (
    .translation = position,
    .scale_x = 1.0,
    .scale_y = 1.0,
    .rotation = 0.0,
  );
}

Scene release[self] -> [] : return;
Scene update[self, .delta_time : R64] -> [] {
  self.elapsed = self.elapsed + delta_time;

  state wrapped_time : R64 = self.elapsed % 16.0;
  self.title_material.parameters.time_milliseconds = new[U32](wrapped_time * 1000.0);

  state input := System::Input -> snapshot();
  if input -> pressed(.key = space) : emit space_pressed;
  if input -> pressed(.key = shift) : emit shift_pressed;
}
